# Copy this file to `.env` and fill in your own key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Sign-In. Create the OAuth clients at
# https://console.cloud.google.com/apis/credentials
# GOOGLE_SERVER_CLIENT_ID is the *Web application* client id — Android and web
# both need it. Leave it empty only if you ship `android/app/google-services.json`.
GOOGLE_SERVER_CLIENT_ID=
# The *iOS* client id. Only needed for iOS/macOS builds without
# `GoogleService-Info.plist`.
GOOGLE_IOS_CLIENT_ID=
